# Cache and runtime artifacts — should not be committed.
# These files exist on disk for the workspace-root copy of scripts/ but are
# not part of the canonical, versioned source.

# BioMart query caches (regenerated on demand)
.biomart_*.csv
.bcg_symbol_*.csv

# Job-submission logs (per-run job IDs)
.submitted_*.csv

# Loop and watcher runtime state
*.log
*.pid

# Python bytecode
__pycache__/
*.pyc
